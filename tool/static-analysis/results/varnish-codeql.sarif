              "properties": {
                "description": "A dataflow lead requiring boundary and source-control review.",
                "id": "cache-key-research/request-to-key",
                "kind": "problem",
                "name": "Request data reaches a cache-key hash input",
                "problem.severity": "recommendation"
              }
            },
            {
              "id": "cache-key-research/ambiguous-apr-join",
              "name": "cache-key-research/ambiguous-apr-join",
              "shortDescription": {
                "text": "Multiple request flows through an unseparated APR join to a cache key"
              },
              "fullDescription": {
                "text": "Candidate only: verify distinct variable-length fields and reachable key use."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning"
              },
              "properties": {
                "description": "Candidate only: verify distinct variable-length fields and reachable key use.",
                "id": "cache-key-research/ambiguous-apr-join",
                "kind": "problem",
                "name": "Multiple request flows through an unseparated APR join to a cache key",
                "problem.severity": "warning"
              }
            }
          ]

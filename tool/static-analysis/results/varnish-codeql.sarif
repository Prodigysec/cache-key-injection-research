              "name": "cache-key-research/request-to-key",
              "shortDescription": {
                "text": "Request data reaches a cache-key hash input"
              },
              "fullDescription": {
                "text": "A dataflow lead requiring boundary and source-control review."
              },
              "defaultConfiguration": {
                "enabled": true,
                "level": "note"
